# Node Environment
NODE_ENV=development
PORT=3000

# Database (Local Docker PostgreSQL — see docker-compose.yml)
DATABASE_URL=postgresql://vault:vaultsecret@localhost:5432/vaultdb
DATABASE_POOL_URL=postgresql://vault:vaultsecret@localhost:5432/vaultdb

# Authentication Secrets
JWT_ACCESS_SECRET=vault_insecure_access_secret_development_minimum_32_bytes_entropy
JWT_REFRESH_SECRET=vault_insecure_refresh_secret_development_minimum_32_bytes_entropy

# Initial Owner Bootstrap (One-Time Seed Provisioning)
INITIAL_OWNER_EMAIL=owner@vault.internal
INITIAL_OWNER_PASSWORD=CorrectHorseBatteryStaple2026!

# Network & Gateway
WEB_APP_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1
