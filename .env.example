# Node Environment
NODE_ENV=development
PORT=3000

# Database (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-vault-instance.region.aws.neon.tech/vaultdb?sslmode=require
DATABASE_POOL_URL=postgresql://user:password@ep-vault-instance-pooler.region.aws.neon.tech/vaultdb?sslmode=require

# Authentication Secrets
JWT_ACCESS_SECRET=vault_insecure_access_secret_development_minimum_32_bytes_entropy
JWT_REFRESH_SECRET=vault_insecure_refresh_secret_development_minimum_32_bytes_entropy

# Initial Owner Bootstrap (One-Time Seed Provisioning)
INITIAL_OWNER_EMAIL=owner@vault.internal
INITIAL_OWNER_PASSWORD=CorrectHorseBatteryStaple2026!

# Network & Gateway
WEB_APP_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
