{
  "name": "rbac-user-portal",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose up -d && pnpm db:setup && turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @rbac/database db:generate",
    "db:migrate": "pnpm --filter @rbac/database db:migrate",
    "db:seed": "pnpm --filter @rbac/database db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:setup": "pnpm --filter @rbac/database db:migrate && pnpm --filter @rbac/database db:seed"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "latest"
  }
}
