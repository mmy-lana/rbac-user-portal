{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (node --watch dist/main.js & tsc -p tsconfig.build.json --watch --preserveWatchOutput)",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/throttler": "latest",
    "@rbac/database": "workspace:*",
    "@rbac/shared": "workspace:*",
    "bcrypt": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "cookie-parser": "latest",
    "dotenv": "latest",
    "passport": "latest",
    "passport-jwt": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@rbac/tsconfig": "workspace:*",
    "@types/bcrypt": "latest",
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/passport-jwt": "latest",
    "typescript": "latest"
  }
}
