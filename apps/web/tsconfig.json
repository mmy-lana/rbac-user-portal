{
  "extends": "@rbac/tsconfig/react.json",
  "compilerOptions": {
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@rbac/shared": ["../../packages/shared/src/index.ts"],
      "@rbac/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}