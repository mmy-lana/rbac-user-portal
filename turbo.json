{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "inputs": ["src/schema/**", "drizzle.config.ts"],
      "outputs": ["migrations/**"],
      "cache": true
    },
    "db:migrate": {
      "dependsOn": ["^db:generate"],
      "inputs": ["migrations/**"],
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["^db:migrate"],
      "inputs": ["src/seed.ts"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "api#build": {
      "dependsOn": ["^build", "@rbac/database#db:migrate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {}
  }
}
