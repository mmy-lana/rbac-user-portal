{
  "name": "@rbac/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx src/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@neondatabase/serverless": "latest",
    "bcrypt": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "@rbac/tsconfig": "workspace:*",
    "@types/bcrypt": "latest",
    "@types/node": "latest",
    "drizzle-kit": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "@types/pg": "latest"
  }
}
